# --- Application auth (K) ---
# Set this in production. Without it, the app runs open for local demos.
APP_AUTH_USER=admin
APP_AUTH_PASSWORD=change-me

# --- Storage (B): Hostinger/Postgres ---
DATABASE_URL=postgres://bcw_user:change-me@localhost:5432/business_card_wizard

# --- OCR (existing + improved pipeline) ---
GOOGLE_VISION_API_KEY=

# --- LLM extraction (A): OpenAI-compatible endpoint ---
# Works with OpenAI, OpenRouter, or any /v1/chat/completions compatible provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Salesforce (D): OAuth refresh token flow ---
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_API_VERSION=60.0
SALESFORCE_LINKEDIN_FIELD=LinkedIn_Profile__c

# --- LinkedIn enrichment (J): choose one provider ---
# Generic webhook gets { contact } and should return JSON enrichment data.
LINKEDIN_ENRICHMENT_WEBHOOK_URL=
LINKEDIN_ENRICHMENT_WEBHOOK_TOKEN=
# Or Proxycurl-compatible provider.
PROXYCURL_API_KEY=

# Used for QR/contact links when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
